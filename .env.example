# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Rate limiting (Upstash Redis, free tier is fine) ---
# If left blank, falls back to in-memory rate limiting (single-instance/dev only).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Captcha ---
# Cloudflare Turnstile is used automatically as soon as both keys below are
# set (this is the primary provider — enable it before a public launch).
# NEXT_PUBLIC_TURNSTILE_SITE_KEY is safe to expose to the browser (that's
# what "public" site keys are for); TURNSTILE_SECRET_KEY must stay server-only.
# With no keys set, falls back to a self-hosted arithmetic + proof-of-work
# challenge — zero config, fine for local dev, not a substitute for Turnstile.
CAPTCHA_PROVIDER=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
CAPTCHA_HMAC_SECRET=change-me-to-a-long-random-string

# --- Email (lead notifications + digest) ---
RESEND_API_KEY=
DIGEST_TO_EMAIL=you@yourdomain.com
DIGEST_FROM_EMAIL=aegis@yourdomain.com

# --- Slack digest (alternative/additional to email) ---
SLACK_WEBHOOK_URL=

# --- Content-similarity clone search (optional) ---
# Only used by the gated /api/consult flow — never called from the free
# scan path. Leave blank to skip this check entirely (the free DNS-based
# lookalike-domain scan still runs either way). Uses Google Programmable
# Search Engine: https://programmablesearchengine.google.com/
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=

# --- JS-rendered deep scan (optional) ---
# Only used by the gated /api/consult flow — never called from the free
# scan path. Re-checks client-side secrets/source-maps/SRI/trust-signals
# against a JS-rendered version of the page (catches what a client-side
# SPA injects after initial load). Uses a hosted headless-browser API
# (Browserless.io-compatible /content endpoint by default — set
# RENDER_API_URL to point at a different provider's equivalent endpoint).
# Leave RENDER_API_KEY blank to skip this check entirely.
RENDER_API_URL=https://chrome.browserless.io/content
RENDER_API_KEY=

# --- JS-rendered deep scan (optional) ---
# Only used by the gated /api/consult flow — never called from the free
# scan path. Re-checks client-side secrets/source-maps/SRI/trust-signals
# against a JS-rendered version of the page (catches what a client-side
# SPA injects after initial load). Uses a hosted headless-browser API
# (Browserless.io-compatible /content endpoint by default — set
# RENDER_API_URL to point at a different provider's equivalent endpoint).
# Leave RENDER_API_KEY blank to skip this check entirely.
RENDER_API_URL=https://chrome.browserless.io/content
RENDER_API_KEY=
# Screenshot endpoint for the perceptual-hash visual comparison — same
# provider, same key, different endpoint path. Only needed if you want
# visual (not just structural) clone comparison.
RENDER_SCREENSHOT_API_URL=https://chrome.browserless.io/screenshot

# --- Reverse image search (optional) ---
# Google Cloud Vision Web Detection — finds any page on the web carrying a
# visually matching image of the target site, without needing a guessed
# candidate domain list. First 1,000 units/month free, then $3.50/1,000.
# Only used by the gated similarity-analysis flow. Leave blank to skip.
GOOGLE_VISION_API_KEY=

# --- Stripe (optional — required for the two paid clone-detection features) ---
# Without these, "Unlock instantly" and "Notify me if a dormant domain
# goes live" return a clear 503 telling the visitor to use "Request
# consultation" instead — nothing breaks, those two paid paths just aren't
# available yet.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_CLONE_REPORT=
STRIPE_PRICE_ID_DOMAIN_WATCH=
STRIPE_PRICE_ID_FIX_GUIDE=
STRIPE_PRICE_ID_SAAS_MONITOR=

# --- Admin login (magic code) ---
# The one email address that can ever receive an admin login code —
# request-code never accepts any other destination. Set both, or the
# admin login flow will fail with a clear error rather than silently not
# working.
ADMIN_EMAIL=
ADMIN_SESSION_SECRET=change-me-to-a-long-random-string

# --- App ---
# APP_URL must be set (including in local dev) — it's used both for links
# in emails and as the expected Origin for the same-origin check on
# /api/lead and /api/monitor (see src/lib/originCheck.ts).
APP_URL=http://localhost:3000
APP_NAME=Aegis
CRON_SECRET=change-me-to-a-long-random-string
NODE_ENV=development
